{
  "name": "maddox-engine",
  "version": "0.11.0",
  "description": "Scans source code or a live deployed page for design-token, motion, and component-state drift against your own design system — the same engine behind Maddox Engine's CI checks.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "maddox": "dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "drift",
    "css",
    "cli",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omrdev1/maddox-cli.git"
  },
  "homepage": "https://www.maddoxengine.com",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "scan": "tsx src/cli.ts",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "author": "Grafikui Ltd <support@maddoxengine.com>"
}
